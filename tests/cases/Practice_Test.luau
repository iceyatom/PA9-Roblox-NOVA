return function(t)
    local Practice=require(game.ServerScriptService.NOVA.Practice)
    t.test("practice starts after three seconds and lasts exactly thirty seconds",function()
        local p=Practice.new()
        local s=p:start("a",100)
        assert(s.starts==103 and s.ends==133 and s.phase=="Countdown")
        assert(not p:fire("a",s.id,1,102.99))
        local changed,finished=0,0
        local function phase() changed+=1 end
        local function done() finished+=1 end
        p:step(102.99,phase,done); assert(changed==0)
        p:step(103,phase,done); assert(changed==1 and s.phase=="Playing")
        assert(p:fire("a",s.id,1,103))
        assert(p:fire("a",s.id,2,132.999))
        assert(not p:fire("a",s.id,3,133))
        p:step(133,phase,done); p:step(140,phase,done)
        assert(finished==1 and s.phase=="Results" and s.score==2)
    end)
    t.test("practice rejects forged sessions, sequences, duplicate presses and remote bursts",function()
        local p=Practice.new(); local s=p:start("a",0)
        p:step(3,function() end,function() end)
        assert(not p:fire("a",s.id+1,1,4))
        for _,value in {0,-1,1.5,math.huge,0/0,2147483648,"1",{}} do
            assert(not p:fire("a",s.id,value,4))
        end
        assert(p:fire("a",s.id,1,4))
        assert(not p:fire("a",s.id,1,4.1))
        assert(not p:fire("a",s.id,2,4.001))
        assert(p:fire("a",s.id,3,4.1))
        assert(s.score==2)
    end)
    t.test("practice isolates players, discards abandoned rounds and invalidates retry packets",function()
        local p=Practice.new(); local a=p:start("a",0); local b=p:start("b",1)
        assert(not p:start("a",2))
        p:step(4,function() end,function() end)
        assert(p:fire("a",a.id,1,5) and not p:fire("b",a.id,2,5))
        assert(a.score==1 and b.score==0)
        p:remove("b")
        local completed=0
        p:step(33,function() end,function(who) assert(who=="a"); completed+=1 end)
        assert(completed==1)
        local retry=p:start("a",34)
        assert(retry.id~=a.id and retry.score==0 and retry.starts==37)
        p:step(37,function() end,function() end)
        assert(not p:fire("a",a.id,2,38))
        assert(p:fire("a",retry.id,1,38))
    end)
end
