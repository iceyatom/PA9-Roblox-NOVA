return function(t)
    local P=require(game.ReplicatedStorage.NOVA.Progression)
    t.test("new players begin at level 1 with no prestige",function()
        local d=P.new()
        assert(d.level==1 and d.prestige==0 and not d.master and d.xp==0 and P.validate(d))
        assert(P.label(d)=="Level 1" and not P.prestige(d))
    end)
    t.test("XP thresholds and multi-level overflow are exact",function()
        local d=P.new()
        assert(P.award(d,99)==0 and d.xp==99)
        assert(P.award(d,1)==1 and d.level==2 and d.xp==0)
        assert(P.award(d,125+150+7)==2 and d.level==4 and d.xp==7 and d.totalXP==382)
    end)
    t.test("wins earn more XP than completed losses or draws",function()
        assert(P.WinXP>P.PlayXP and P.PlayXP>0)
        local a,b=P.new(),P.new()
        P.award(a,P.WinXP); P.award(b,P.PlayXP)
        assert(a.totalXP>b.totalXP)
    end)
    t.test("all ten prestiges require level 55 and reset level and XP",function()
        local d=P.new()
        for prestige=1,10 do
            assert(not P.prestige(d))
            P.award(d,1000000)
            assert(d.level==55 and d.xp==0)
            local lifetime=d.totalXP
            assert(P.prestige(d) and d.prestige==prestige and d.level==1 and d.xp==0 and not d.master)
            assert(d.totalXP==lifetime and P.validate(d))
        end
        assert(not P.prestige(d))
        P.award(d,1000000)
        assert(P.prestige(d) and d.prestige==10 and d.master and d.level==55)
        assert(not P.prestige(d) and P.validate(d))
    end)
    t.test("master continues past 55 and caps at exactly 1000",function()
        local d={level=55,prestige=10,master=true,xp=0,totalXP=0}
        P.award(d,P.cost(55))
        assert(d.level==56 and d.xp==0)
        P.award(d,1000000000)
        assert(d.level==1000 and d.xp==0 and P.validate(d))
        P.award(d,100)
        assert(d.level==1000 and d.xp==0 and not P.canPrestige(d))
    end)
    t.test("bad saved profiles cannot become valid ranks",function()
        for _,change in {{level=56},{prestige=11},{master=true},{xp=-1},{xp=100},{level=1.5},{totalXP=0/0}} do
            local d=P.new()
            for k,v in change do d[k]=v end
            assert(not P.validate(d))
        end
        assert(not P.validate(false) and not P.validate({}))
        local d=P.new(); d.level=55; d.xp=1
        assert(not P.validate(d))
    end)
    t.test("caps discard excess XP and prevent banking across prestige",function()
        local d=P.new(); d.level=54
        P.award(d,P.cost(54)+999999)
        assert(d.level==55 and d.xp==0)
        P.prestige(d)
        assert(d.level==1 and d.xp==0)
    end)
end
