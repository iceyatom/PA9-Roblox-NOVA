return function(t)
    local I=require(game.ReplicatedStorage.NOVA.Inventory)
    local Drop=require(game.ReplicatedStorage.NOVA.CrateDrop)
    local function reward(data,key,outcome,roll) return I.matchReward(data,key,os.time()+86400,outcome,roll) end
    t.test("only completed elimination wins spin; losses boost and other results are excluded",function()
        assert(Drop.outcome(1,"Elimination",1)=="win" and Drop.outcome(1,"Elimination",2)=="loss")
        assert(Drop.outcome(2,"Elimination",2)=="win" and Drop.outcome(2,"Elimination",1)=="loss")
        for _,reason in {"Disconnect","Draw","Waiting","Practice"} do assert(not Drop.outcome(1,reason,1)) end
        assert(not Drop.outcome(0,"Elimination",1))
    end)
    t.test("new and legacy profiles start at 25 percent without free crates",function()
        local data=I.new();assert(data.crateChance==25 and not data.owned.crate_season1)
        data.crateChance=nil;data.dropReceipts=nil;data.dropOrder=nil
        data=assert(I.validate(data));assert(data.crateChance==25 and #data.dropOrder==0)
    end)
    t.test("win failure multiplies by 1.5; loss multiplies by 1.2 without a draw",function()
        local data=I.new();local ok,r=reward(data,"miss","win",.75)
        assert(ok and not r.awarded and r.chance==25 and r.landing==.75 and r.nextChance==37.5)
        assert(data.crateChance==37.5 and not data.owned.crate_season1)
        ok,r=reward(data,"loss","loss",nil)
        assert(ok and not r.awarded and r.landing==nil and r.chance==37.5 and r.nextChance==45)
        assert(data.crateChance==45 and not data.owned.crate_season1)
    end)
    t.test("exact chance boundary misses, a lit-arc hit grants one crate and resets to 25",function()
        local data=I.new();local ok,r=reward(data,"boundary","win",.25)
        assert(ok and not r.awarded and data.crateChance==37.5)
        ok,r=reward(data,"hit","win",.374999)
        assert(ok and r.awarded and r.chance==37.5 and r.nextChance==25)
        assert(data.owned.crate_season1==1 and data.crateChance==25)
    end)
    t.test("chance caps at 100 and guarantees a crate on the next win",function()
        local data=I.new();data.crateChance=90
        assert(reward(data,"cap","win",.95));assert(data.crateChance==100)
        assert(reward(data,"loss-at-cap","loss"));assert(data.crateChance==100)
        local ok,r=reward(data,"guaranteed","win",1)
        assert(ok and r.awarded and r.landing<1 and data.owned.crate_season1==1 and data.crateChance==25)
    end)
    t.test("replays survive serialization and cannot grant or boost twice",function()
        local data=I.new();assert(reward(data,"loss","loss"));data=assert(I.validate(data))
        local ok,r,replay=reward(data,"loss","loss");assert(ok and replay and r.nextChance==30 and data.crateChance==30)
        assert(reward(data,"hit","win",0));data=assert(I.validate(data))
        ok,r,replay=reward(data,"hit","win",.99)
        assert(ok and replay and r.awarded and r.landing==0 and data.owned.crate_season1==1 and data.crateChance==25)
        assert(not reward(data,"hit","loss"))
    end)
    t.test("evicting display receipts retains match deduplication until expiry",function()
        local data=I.new()
        for i=1,70 do assert(reward(data,"loss:"..i,"loss")) end
        assert(#data.dropOrder==Drop.ReceiptLimit and not data.dropReceipts["loss:1"])
        data=assert(I.validate(data))
        local ok,r,replay=reward(data,"loss:1","loss")
        assert(ok and replay and not r and data.crateChance==100 and not data.owned.crate_season1)
    end)
    t.test("malformed chance, receipts, expired results and full inventories cannot mutate",function()
        for _,value in {-1,0,24,101,math.huge,0/0,"25"} do local d=I.new();d.crateChance=value;assert(not I.validate(d)) end
        local d=I.new();assert(not I.matchReward(d,"expired",os.time()-1,"win",0))
        assert(not reward(d,"bad","draw",0) and not reward(d,"bad","win",0/0))
        d.owned.crate_season1=1000000
        assert(not reward(d,"full","win",0) and d.crateChance==25 and not d.wins.full)
        d=I.new();assert(reward(d,"x","win",0));d.dropReceipts.x.landing=.9;assert(not I.validate(d))
    end)
end
