return function(t)
    local F=require(script.Parent.Parent.Fixture)
    local Match=require(game.ServerScriptService.NOVA.Match)
    local cfg=require(game.ReplicatedStorage.NOVA.Config)
    local map=require(game.ReplicatedStorage.NOVA.Map1).arena
    t.test("waiting, countdown, two-seat capacity, reset",function()
        local s=Match.new(map,cfg)
        assert(s:join(11)==1 and s.phase=="Waiting" and not s:intent(1,0,"fire",1))
        assert(s:join(22)==2 and s.phase=="Countdown" and not s:join(33))
        assert(not s:intent(2,s.round,"move",1,true))
        F.advance(s,179); assert(s.phase=="Countdown"); F.advance(s,1); assert(s.phase=="Playing")
    end)
    t.test("both must rematch and stale intents rejected",function()
        local s=F.duel(); s:finish(1,"Elimination")
        local round=s.round; s:intent(1,round,"rematch"); s:intent(1,round,"rematch")
        assert(s.phase=="Results"); s:intent(2,round,"rematch")
        assert(s.phase=="Countdown" and s.round==round+1 and not s.votes[1] and not s.winner)
        assert(s.bodies[1].hp==10 and #s.bullets==0)
        s:step(3); assert(not s:intent(1,round,"fire",1))
    end)
    t.test("disconnect in countdown vs combat",function()
        local s=F.duel(); s:depart(1)
        assert(s.winner==2 and s.reason=="Disconnect" and s.phase=="Results")
        s:intent(2,s.round,"rematch"); assert(s.phase=="Waiting")
        s:join("replacement"); s:depart(2)
        assert(s.phase=="Waiting" and not s.winner and not next(s.votes))
    end)
    t.test("reject invalid intentions without changing authoritative fields",function()
        local s=F.duel()
        for _,kind in {"hit","health","winner","position",{},false} do assert(not s:intent(1,s.round,kind,0,false)) end
        assert(not s:intent(1,s.round,"move",15,false) and not s:intent(1,s.round,"move",1,{}))
        assert(s.bodies[1].hp==10 and s.bodies[1].axis==0 and not s.winner)
    end)
end
