return function(t)
    local shared=game.ReplicatedStorage.NOVA
    local S=require(shared.Stats)
    local I=require(shared.Inventory)
    local Store=require(game.ServerScriptService.NOVA.InventoryStore)
    local F=require(script.Parent.Parent.Fixture)
    local function event(key,outcome,map,shots)
        return {key=key,outcome=outcome,mapId=map or "SplitCircuit",mapName=map or "Split Circuit",shots=shots or 10}
    end
    t.test("career records wins losses draws and consecutive win streaks",function()
        local d=S.new()
        for i,result in {"win","win","loss","win","draw","win","win","win"} do assert(S.record(d,event(tostring(i),result))) end
        assert(d.matchesPlayed==8 and d.wins==6 and d.losses==1 and d.draws==1)
        assert(d.currentWinStreak==3 and d.longestWinStreak==3 and d.shotsFired==80)
        assert(d.maps.SplitCircuit.matches==8 and d.maps.SplitCircuit.wins==6)
        assert(S.ratio(d)=="6.00" and S.validate(d))
        assert(S.ratio(S.new())=="—")
    end)
    t.test("match receipts survive serialization and prevent duplicated totals and streaks",function()
        local d=S.new();assert(S.record(d,event("one","win")))
        d=assert(S.validate(d));local ok,replay=S.record(d,event("one","loss",nil,999))
        assert(ok and replay and d.matchesPlayed==1 and d.wins==1 and d.losses==0 and d.shotsFired==10)
        assert(S.ratio(d)=="∞")
    end)
    t.test("best map sorts by wins then win rate then stable ID",function()
        local d=S.new();assert(not S.bestMap(d))
        S.record(d,event("a1","win","Alpha"));S.record(d,event("a2","loss","Alpha"))
        S.record(d,event("b1","win","Beta"));assert(S.bestMap(d).id=="Beta")
        S.record(d,event("a3","win","Alpha"));assert(S.bestMap(d).id=="Alpha")
        S.record(d,event("b2","win","Beta"));assert(S.bestMap(d).id=="Beta")
        S.record(d,event("b3","loss","Beta"));assert(S.bestMap(d).id=="Alpha")
    end)
    t.test("single and batch crate stats commit once and replay does not increase them",function()
        local d=I.new();I.grant(d,"crate_season1",9)
        assert(I.open(d,"crate_season1","open:1",0));assert(d.stats.cratesOpened==1)
        assert(I.openMany(d,"crate_season1","open:2",3,{0,0,0}));assert(d.stats.cratesOpened==4)
        d=assert(I.validate(d));assert(I.openMany(d,"crate_season1","open:2",3,{0,0,0}))
        assert(d.stats.cratesOpened==4 and d.owned.crate_season1==5)
        assert(I.openMany(d,"crate_season1","open:5",5,{0,0,0,0,0}));assert(d.stats.cratesOpened==9)
        assert(not I.open(d,"crate_season1","open:10",0) and d.stats.cratesOpened==9)
    end)
    t.test("legacy profiles recover crate opening sequence without inventing match history",function()
        local raw=I.new();raw.stats=nil;raw.openSequence=1234
        local d=assert(I.validate(raw));assert(d.stats.cratesOpened==1234 and d.stats.matchesPlayed==0)
        assert(I.validate(d).stats.cratesOpened==1234)
    end)
    t.test("malformed stats cannot replace valid saved profiles",function()
        local d=S.new();d.matchesPlayed=1;assert(not S.validate(d))
        d=S.new();d.shotsFired=-1;assert(not S.validate(d))
        d=S.new();d.longestWinStreak=1;assert(not S.validate(d))
        d=S.new();S.record(d,event("x","win"));d.maps.SplitCircuit.wins=0;d.maps.SplitCircuit.losses=1;assert(not S.validate(d))
        local raw=I.new();raw.stats={};assert(not I.validate(raw))
    end)
    t.test("invalid match events do not partially mutate stats",function()
        local d=S.new();local e=event("x","win");e.shots=0/0;assert(not S.record(d,e))
        e=event("x","forged");assert(not S.record(d,e))
        e=event("x","win");e.mapId="";assert(not S.record(d,e))
        assert(d.matchesPlayed==0 and not next(d.maps) and d.shotsFired==0)
    end)
    t.test("career receipts are bounded and validation returns independent copies",function()
        local d=S.new();for i=1,140 do S.record(d,event(tostring(i),"win")) end
        assert(#d.receiptOrder==S.ReceiptLimit and not d.receipts["1"] and d.receipts["140"])
        local copy=assert(S.validate(d));copy.maps.SplitCircuit.wins=0;copy.receipts["140"]=nil
        assert(d.maps.SplitCircuit.wins==140 and d.receipts["140"])
    end)
    t.test("career totals and crate stats survive an ambiguous save and rejoin",function()
        local values={};local fail=false;local storage={}
        function storage:UpdateAsync(key,fn)
            local value=fn(values[key]);if value then values[key]=value end
            if fail then error("Saved but response lost") end;return value
        end
        local a=Store.new(storage,"a",function() return 1000 end);local p=assert(a:load(1))
        S.record(p.data.stats,event("a/round1","win"));I.grant(p.data,"crate_season1",1);I.open(p.data,"crate_season1","open:1",0)
        fail=true;assert(not a:save(1,p,false));fail=false;assert(a:save(1,p,true))
        local b=Store.new(storage,"b",function() return 1001 end);local d=assert(b:load(1)).data
        S.record(d.stats,event("a/round1","win"));assert(d.stats.matchesPlayed==1 and d.stats.cratesOpened==1 and d.stats.shotsFired==10)
    end)
    t.test("only accepted duel shots count and finished callbacks cannot double record",function()
        local sim=F.duel();local d=S.new()
        assert(sim:intent(1,sim.round,"fire",1));assert(not sim:intent(1,sim.round,"fire",1))
        assert(not sim:intent(1,sim.round-1,"fire",2));assert(sim:intent(1,sim.round,"fire",2))
        sim.finished=function(s) S.record(d,event(tostring(s.round),"win","test",s.bodies[1].acceptedShots or 0)) end
        sim:finish(1,"Elimination");sim:finish(1,"Elimination")
        assert(d.matchesPlayed==1 and d.shotsFired==2)
        sim:intent(1,sim.round,"rematch");sim:intent(2,sim.round,"rematch");sim:step(sim.cfg.Countdown)
        sim:finish(1,"Elimination");assert(d.matchesPlayed==2 and d.shotsFired==2 and d.longestWinStreak==2)
    end)
end
